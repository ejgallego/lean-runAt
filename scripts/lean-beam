set -euo pipefail

usage() {
  cat <<'EOF' >&2
usage:
  lean-beam --version
  lean-beam version
  lean-beam [--root PATH] [--session-dir DIR] [--port N] serve [lean|rocq]
  lean-beam [--root PATH] run-at <path> <version> <line> <character> [--stdin | --text-file <path> | -- <text...> | <text...>]
  lean-beam [--root PATH] run-at-handle <path> <version> <line> <character> [--stdin | --text-file <path> | -- <text...> | <text...>]
  lean-beam [--root PATH] hover <path> <version> <line> <character>
  lean-beam [--root PATH] signature-help <path> <version> <line> <character>
  lean-beam [--root PATH] definition <path> <version> <line> <character>
  lean-beam [--root PATH] references <path> <version> <line> <character> [--include-declaration|--exclude-declaration]
  lean-beam [--root PATH] document-symbols <path> <version>
  lean-beam [--root PATH] workspace-symbols <query...>
  lean-beam [--root PATH] goals before|after <path> <version> <line> <character>
  lean-beam [--root PATH] todo <path> <version> <startLine> <startCharacter> <endLine> <endCharacter> [--kind <kind> ...] [--suggest none|basic]
  lean-beam [--root PATH] run-with <path> <handle-json|-|--handle-file <path>> [--stdin | --text-file <path> | -- <text...> | <text...>]
  lean-beam [--root PATH] run-with-linear <path> <handle-json|-|--handle-file <path>> [--stdin | --text-file <path> | -- <text...> | <text...>]
  lean-beam [--root PATH] release <path> <handle-json|-|--handle-file <path>>
  lean-beam [--root PATH] update <path>
  lean-beam [--root PATH] sync <path> [+all-diagnostics]
  lean-beam [--root PATH] refresh <path> [+all-diagnostics]
  lean-beam [--root PATH] save <path> [+all-diagnostics]
  lean-beam [--root PATH] close <path>
  lean-beam [--root PATH] close-save <path> [+all-diagnostics]
  lean-beam [--root PATH] rocq-goals-after <path> <line> <character> [text...]
  lean-beam [--root PATH] rocq-goals-prev <path> <line> <character> [text...]
  lean-beam [--root PATH] feedback-report --stdin|--input <path> [--bundle none|dir|zip] [--output-dir <path>] [--no-redact]
  lean-beam prune [--apply] [--bundles]
  lean-beam validated-toolchains [lean]
  lean-beam compatible-release-lines
  lean-beam [--root PATH] doctor [lean|rocq]
  lean-beam [--root PATH] open-files
  lean-beam [--root PATH] stats
  lean-beam [--root PATH] reset-stats
  lean-beam [--root PATH] [--session-dir DIR] status
  lean-beam --root PATH [--session-dir DIR] stop
  lean-beam --root PATH [--session-dir DIR] recover --generation ID | --force
  lean-beam --root PATH [--session-dir DIR] request-stream <json|->
  lean-beam [--root PATH] cancel <request-id>

notes:
  - pass an absolute --session-dir DIR before the command to select one exact alternate session directory; repeat it for every participant
  - lean-beam keeps the Lean wrapper surface primary; optional Rocq goal probes are documented in docs/ROCQ.md
  - start a Rocq session with `lean-beam serve rocq`
  - other common Rocq entry points are `lean-beam doctor rocq`, `lean-beam rocq-goals-after`, and `lean-beam rocq-goals-prev`
  - run `lean-beam update <path>` first, then pass its returned `version` to Lean position/range probes
  - run `lean-beam sync <path>` when you also need the diagnostics/readiness barrier
  - for multiline text-carrying Lean probes, prefer `--stdin` or `--text-file <path>`; use `--` before text that starts with `--`
  - for handle-based commands, use `--handle-file <path>` when you do not want to inline handle json
  - wrapper commands require one live session owner; start `serve` in a foreground process and keep it running
  - abnormal session state remains fenced; after verifying the old generation is gone, use `recover --generation ID`
  - set `BEAM_DEBUG_TEXT=1` to print the exact escaped text and UTF-8 bytes sent for text-carrying Lean probes
  - use `lean-beam --version` for bug reports and installed runtime identity checks
  - validated-toolchains lists exact CI-validated versions; compatible-release-lines lists canonical RC/patch families qualified locally
  - prune previews old installed runtimes; restart active agents and MCP clients before using --apply
  - prune --bundles also selects stale installed bundle-cache entries
  - Beam does not upload or submit feedback; use `lean-beam feedback-report` to print a pasteable report with debug context
  - review non-confidential output before posting it publicly
  - set feedback `confidential` to true for non-public workspaces; confidential reports must not be posted publicly
EOF
}

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  local dir=""
  while [ -L "$source" ]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    case "$source" in
      /*)
        ;;
      *)
        source="$dir/$source"
        ;;
    esac
  done
  dir="$(cd -P "$(dirname "$source")" && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$source")"
}

script_path="$(resolve_script_path)"
script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
beam_home_explicit=0
if [ -n "${BEAM_HOME:-}" ]; then
  beam_home="$BEAM_HOME"
  beam_home_explicit=1
else
  beam_home="$(cd -P "$script_dir/.." && pwd)"
fi
beam_bin=""
if [ "$beam_home_explicit" -eq 1 ]; then
  if [ -x "$beam_home/libexec/beam-cli" ]; then
    beam_bin="$beam_home/libexec/beam-cli"
  elif [ -x "$beam_home/.lake/build/bin/beam-cli" ]; then
    beam_bin="$beam_home/.lake/build/bin/beam-cli"
  fi
else
  if [ -x "$beam_home/.lake/build/bin/beam-cli" ]; then
    beam_bin="$beam_home/.lake/build/bin/beam-cli"
  elif [ -x "$beam_home/libexec/beam-cli" ]; then
    beam_bin="$beam_home/libexec/beam-cli"
  fi
fi

if [ -z "$beam_bin" ] || [ ! -x "$beam_bin" ]; then
  echo "missing beam-cli executable under $beam_home" >&2
  exit 1
fi

if [ -z "${BEAM_INSTALL_BUNDLE_DIR:-}" ]; then
  case "$beam_home" in
    */versions/*)
      install_root="$(cd -P "$beam_home/../.." && pwd)"
      default_install_bundle_dir="$install_root/state/install-bundles"
      if [ -d "$default_install_bundle_dir" ]; then
        export BEAM_INSTALL_BUNDLE_DIR="$default_install_bundle_dir"
      fi
      ;;
  esac
fi
export BEAM_HOME="$beam_home"

prefix=()
cmd=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --root|--session-dir|--port)
      [ "$#" -ge 2 ] || break
      prefix+=("$1" "$2")
      shift 2
      ;;
    *)
      cmd="$1"
      shift
      break
      ;;
  esac
done

rest=("$@")
mapped=()
display_cmd=""

if [ -z "$cmd" ]; then
  usage
  exit 0
fi

case "$cmd" in
  -h|--help|help)
    usage
    exit 0
    ;;
  run-at)
    mapped=("lean-run-at")
    display_cmd="$cmd"
    ;;
  run-at-handle)
    mapped=("lean-run-at-handle")
    display_cmd="$cmd"
    ;;
  hover)
    mapped=("lean-hover")
    display_cmd="$cmd"
    ;;
  signature-help)
    mapped=("lean-signature-help")
    display_cmd="$cmd"
    ;;
  definition)
    mapped=("lean-definition")
    display_cmd="$cmd"
    ;;
  references)
    mapped=("lean-references")
    display_cmd="$cmd"
    ;;
  document-symbols)
    mapped=("lean-document-symbols")
    display_cmd="$cmd"
    ;;
  workspace-symbols)
    mapped=("lean-workspace-symbols")
    display_cmd="$cmd"
    ;;
  goals)
    mapped=("lean-goals")
    display_cmd="$cmd"
    ;;
  todo)
    mapped=("lean-todo")
    display_cmd="$cmd"
    ;;
  run-with)
    mapped=("lean-run-with")
    display_cmd="$cmd"
    ;;
  run-with-linear)
    mapped=("lean-run-with-linear")
    display_cmd="$cmd"
    ;;
  release)
    mapped=("lean-release")
    display_cmd="$cmd"
    ;;
  update)
    mapped=("lean-update")
    display_cmd="$cmd"
    ;;
  sync)
    mapped=("lean-sync")
    display_cmd="$cmd"
    ;;
  refresh)
    mapped=("lean-refresh")
    display_cmd="$cmd"
    ;;
  save)
    mapped=("lean-save")
    display_cmd="$cmd"
    ;;
  close)
    mapped=("lean-close")
    display_cmd="$cmd"
    ;;
  close-save)
    mapped=("lean-close-save")
    display_cmd="$cmd"
    ;;
  prune)
    mapped=("install-prune")
    ;;
  serve)
    if [ "${#rest[@]}" -eq 0 ]; then
      mapped=("serve" "lean")
      rest=()
    else
      mapped=("serve")
    fi
    ;;
  doctor)
    if [ "${#rest[@]}" -eq 0 ]; then
      mapped=("doctor" "lean")
      rest=()
    else
      mapped=("doctor")
    fi
    ;;
  validated-toolchains)
    if [ "${#rest[@]}" -eq 0 ]; then
      mapped=("validated-toolchains" "lean")
      rest=()
    else
      mapped=("validated-toolchains")
    fi
    ;;
  feedback-report)
    mapped=("feedback-report")
    display_cmd="$cmd"
    ;;
  *)
    mapped=("$cmd")
    ;;
esac

if [ -n "$display_cmd" ]; then
  export BEAM_WRAPPER_COMMAND="$display_cmd"
else
  unset BEAM_WRAPPER_COMMAND
fi
case "$cmd" in
  version|--version|feedback-report)
    export BEAM_WRAPPER_PATH="$script_path"
    export BEAM_PUBLIC_COMMAND="lean-beam"
    ;;
  *)
    unset BEAM_WRAPPER_PATH
    unset BEAM_PUBLIC_COMMAND
    ;;
esac

if [ -n "${prefix[*]-}" ]; then
  if [ -n "${rest[*]-}" ]; then
    exec "$beam_bin" ${prefix[@]+"${prefix[@]}"} ${mapped[@]+"${mapped[@]}"} ${rest[@]+"${rest[@]}"}
  else
    exec "$beam_bin" ${prefix[@]+"${prefix[@]}"} ${mapped[@]+"${mapped[@]}"}
  fi
else
  if [ -n "${rest[*]-}" ]; then
    exec "$beam_bin" ${mapped[@]+"${mapped[@]}"} ${rest[@]+"${rest[@]}"}
  else
    exec "$beam_bin" ${mapped[@]+"${mapped[@]}"}
  fi
fi
